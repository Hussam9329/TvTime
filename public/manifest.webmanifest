{
  "id": "/",
  "name": "Trakora",
  "short_name": "Trakora",
  "description": "Track movies, TV shows, anime and Arabic content.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "orientation": "any",
  "categories": [
    "entertainment",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/logo.svg?v=4",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Discover",
      "url": "/?view=discover",
      "icons": [
        {
          "src": "/logo.svg?v=4",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "TV Shows",
      "url": "/?view=tv-shows",
      "icons": [
        {
          "src": "/logo.svg?v=4",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Calendar",
      "url": "/?view=calendar",
      "icons": [
        {
          "src": "/logo.svg?v=4",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Stats",
      "url": "/?view=stats",
      "icons": [
        {
          "src": "/logo.svg?v=4",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false
}
