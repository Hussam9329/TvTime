    "typecheck": "tsc --noEmit",
    "lint:strict": "eslint . --max-warnings=0",
    "verify:ci": "node scripts/verify-ci.mjs",
    "verify:patch-10": "node --experimental-strip-types --loader ./scripts/ts-path-loader.mjs scripts/test-patch-10.ts && node scripts/verify-patch-10.mjs",
